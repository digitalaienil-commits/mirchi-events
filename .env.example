# PostgreSQL connection string
DATABASE_URL=postgres://mirchi_events:CHANGE_ME@127.0.0.1:5432/mirchi_events

# Signs admin login cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Where uploaded posters are stored (keep this outside the app folder on the VM, and back it up)
UPLOAD_DIR=./uploads

# Only set to "false" while testing over plain http without HTTPS
# COOKIE_SECURE=false

# Vercel only: set automatically when a Blob store is connected to the project.
# When present, posters are stored in Vercel Blob instead of UPLOAD_DIR.
# BLOB_READ_WRITE_TOKEN=
